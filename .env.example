name: "Configuração de ambiente"
description: "Variáveis de ambiente necessárias para o CI/CD"

properties:
  - name: VITE_SUPABASE_URL
    required: true
    description: "URL do projeto Supabase (ex: https://xyz.supabase.co)"
    default: ""
  - name: VITE_SUPABASE_ANON_KEY
    required: true
    description: "Chave anônima do Supabase"
    default: ""
